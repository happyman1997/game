{
  "name": "crown-and-dynasty",
  "private": true,
  "version": "0.1.0",
  "description": "Модульная grand strategy в духе Crusader Kings 3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
